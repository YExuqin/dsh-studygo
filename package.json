{
  "name": "dsh-studygo",
  "version": "0.1.0",
  "description": "DSH 学习题库：结构化答题 + 步骤级追问 + 库级记忆",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib",
    "courses",
    "vendor",
    "scripts/ocr.ps1",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "study",
    "question-bank",
    "spaced-repetition",
    "math"
  ],
  "engines": {
    "node": ">=22"
  }
}
